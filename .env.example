# Names only. Never commit real values.
#
# .env.local  -> read by Next.js and the Convex CLI
# .env        -> read by docker compose (n8n secrets)
# Convex function env vars are set on the deployment: `npx convex env set NAME value`

# --- .env.local (Next.js + Convex CLI) ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Convex deployment env (npx convex env set) ---
CLERK_JWT_ISSUER_DOMAIN=
ADMIN_EMAILS=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_AUTH_TOKEN=
LENDLOOP_N8N_HMAC_SECRET=
LENDLOOP_CONVEX_HMAC_SECRET=

# --- .env (docker compose -> n8n container) ---
LENDLOOP_N8N_HMAC_SECRET=
LENDLOOP_CONVEX_HMAC_SECRET=
CONVEX_HTTP_URL=
