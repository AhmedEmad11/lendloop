# Names only. Never commit real values. See README > Environment variables.

# ---------------------------------------------------------------------------
# .env  (you create it; read by Next.js and docker compose)
# ---------------------------------------------------------------------------
# From the Clerk dashboard (API keys). Required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional, comma-separated: these emails become admins on first sign-in.
ADMIN_EMAILS=
# Generated by scripts/bootstrap.sh if missing (openssl rand -hex 32).
LENDLOOP_N8N_HMAC_SECRET=
LENDLOOP_CONVEX_HMAC_SECRET=
N8N_WEBHOOK_AUTH_TOKEN=
# Failure drill only: true makes the n8n send nodes throw.
LENDLOOP_FORCE_FAIL=

# ---------------------------------------------------------------------------
# .env.local  (written by scripts/bootstrap.sh; read by Next.js + Convex CLI)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Convex deployment env  (set by scripts/bootstrap.sh via `npx convex env set`)
# ---------------------------------------------------------------------------
# CLERK_JWT_ISSUER_DOMAIN   derived from the publishable key
# N8N_WEBHOOK_URL           http://n8n:5678/webhook
# N8N_WEBHOOK_AUTH_TOKEN, LENDLOOP_N8N_HMAC_SECRET, LENDLOOP_CONVEX_HMAC_SECRET, ADMIN_EMAILS

# ---------------------------------------------------------------------------
# n8n container  (set in docker-compose.yml)
# ---------------------------------------------------------------------------
# CONVEX_HTTP_URL           http://backend:3211
